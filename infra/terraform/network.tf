# Usa la VPC y subnets por defecto de la cuenta (suficiente para un single-node).
data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

# --- Security Group del backend (EC2): HTTP/HTTPS público, SSH restringido ---
resource "aws_security_group" "backend" {
  name        = "${var.project_name}-backend-sg"
  description = "SSH, HTTP y HTTPS al backend FuturoTech"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_ssh_cidr]
  }

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "Salida a internet (APIs de IA, actualizaciones)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.project_name}-backend-sg" }
}

# --- Security Group de la base de datos: PostgreSQL solo desde el backend ---
resource "aws_security_group" "database" {
  name        = "${var.project_name}-database-sg"
  description = "PostgreSQL solo desde el backend EC2"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description     = "PostgreSQL desde el backend"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.backend.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.project_name}-database-sg" }
}
