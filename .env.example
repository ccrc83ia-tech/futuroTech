# ============================================================
# FuturoTech AI — Variables de entorno
# Copiar a .env y completar los valores.
# ============================================================

# --- Base de datos ---
DB_NAME=legal_engine
DB_USER=legal
DB_PASSWORD=cambia-esta-clave

# --- IA: proveedor de generación ---
# "groq" (nube, por defecto) u "ollama" (local/on-premise).
AI_PROVIDER=groq

# --- Groq (generación de texto, API compatible con OpenAI) ---
# Obtén tu clave en https://console.groq.com  (NO la subas al repositorio).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (embeddings para RAG; y generación si AI_PROVIDER=ollama) ---
OLLAMA_GEN_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Seguridad (OBLIGATORIO en producción) ---
# Generar una clave aleatoria larga, p.ej.:  openssl rand -base64 48
JWT_SECRET=
