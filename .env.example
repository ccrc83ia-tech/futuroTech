# ============================================================
# FuturoTech AI — Variables de entorno
# Copiar a .env y completar los valores.
# ============================================================

# --- Base de datos ---
DB_NAME=legal_engine
DB_USER=legal
DB_PASSWORD=cambia-esta-clave

# --- IA (Ollama local) ---
OLLAMA_GEN_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Seguridad (OBLIGATORIO en producción) ---
# Generar una clave aleatoria larga, p.ej.:  openssl rand -base64 48
JWT_SECRET=
