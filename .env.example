# ============================================================
# FuturoTech AI — Variables de entorno
# Copiar a .env y completar los valores.
# ============================================================

# --- Base de datos ---
DB_NAME=legal_engine
DB_USER=legal
DB_PASSWORD=cambia-esta-clave

# ============================================================
# IA — Pipeline multi-proveedor (todo API compatible con OpenAI)
# Costo cero por defecto. Para cambiar de proveedor en cualquier
# rol basta con ajustar *_BASE_URL, *_MODEL y la API key.
# ============================================================

# --- Clave de Gemini (Google AI Studio) ---
# Se usa para el GENERADOR y para los EMBEDDINGS.
# Obtén tu clave en https://aistudio.google.com  (NO la subas al repositorio).
GEMINI_API_KEY=

# --- Clave de Groq (verificador de citas) ---
# Obtén tu clave en https://console.groq.com
GROQ_API_KEY=

# --- Clave de OpenRouter (verificador de datos — DeepSeek) ---
# Obtén tu clave en https://openrouter.ai
OPENROUTER_API_KEY=

# --- Rol 1: Generador (redacta el documento). Default Gemini Flash ---
AI_GENERATOR_MODEL=gemini-2.5-flash
# AI_GENERATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Rol 2: Verificador de citas legales. Default Groq + Llama ---
AI_VERIFIER_CITATIONS_MODEL=llama-3.3-70b-versatile
# AI_VERIFIER_CITATIONS_BASE_URL=https://api.groq.com/openai/v1

# --- Rol 3: Verificador de datos/cálculos. Default DeepSeek vía OpenRouter ---
AI_VERIFIER_DATA_MODEL=deepseek/deepseek-chat-v3:free
# AI_VERIFIER_DATA_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings para el RAG (Gemini, 768 dims → vector(768)) ---
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIMENSIONS=768

# --- Interruptores de verificación anti-alucinación ---
VERIFICATION_ENABLED=true
VERIFICATION_CITATIONS_ENABLED=true
VERIFICATION_DATA_ENABLED=true

# --- Seguridad (OBLIGATORIO en producción) ---
# Generar una clave aleatoria larga, p.ej.:  openssl rand -base64 48
JWT_SECRET=
